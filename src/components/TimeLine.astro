---
// src/components/TimelineItem.astro
interface Job {
  date: string;
  title: string;
  company: string;
  description: string;
}

interface Props {
  item: Job;
  isLeft: boolean;
  animationDelay?: string;
}

const { item, isLeft, animationDelay = "0s" } = Astro.props;

const containerClasses = isLeft
  ? "mb-8 flex flex-col md:flex-row justify-between items-center w-full"
  : "mb-8 flex flex-col md:flex-row-reverse justify-between items-center w-full";

const contentContainerClasses = "order-2 md:order-1 w-full md:w-5/12";

const animationClass = isLeft
  ? "animate-slide-in-left-bounce"
  : "animate-slide-in-right-bounce";
---

<div class={containerClasses} style={`--animation-delay: ${animationDelay};`}>
  <div class="hidden md:block order-1 md:w-5/12"></div>

  <div
    class="z-20 flex items-center order-1 bg-gray-800 dark:bg-blue-500 shadow-xl w-8 h-8 rounded-full timeline-dot-wrapper"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 mx-auto text-white"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
        clip-rule="evenodd"></path>
    </svg>
  </div>

  <div class:list={[contentContainerClasses, animationClass]}>
    <div
      class="bg-white dark:bg-gray-800 rounded-lg shadow-xl px-6 py-4
             transform transition-transform duration-300 hover:scale-[1.02]
             hover:shadow-2xl hover:border-blue-500 dark:hover:border-blue-300 border border-transparent"
    >
      <p class="text-sm text-gray-600 dark:text-gray-400">{item.date}</p>
      <h3 class="font-bold text-gray-800 dark:text-white text-xl">
        {item.title}
      </h3>
      <h4 class="font-semibold text-gray-700 dark:text-gray-300 mb-2">
        {item.company}
      </h4>
      <p
        class="text-sm leading-snug tracking-wide text-gray-900 dark:text-gray-100 text-opacity-100"
      >
        {item.description}
      </p>
    </div>
  </div>
</div>
